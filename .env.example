# ─────────────────────────────────────────────────────────────────────────────
# Carriage Health — environment variable template
# Copy this file to .env.local and fill in your values.
# .env.local is in .gitignore and must NEVER be committed to git.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase (get these from your Supabase project → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Use the LEGACY service_role JWT (eyJ...) from Supabase → Settings → API → Legacy keys.
# The new sb_secret_* format requires a newer SDK; switch at Phase 7 hardening.
SUPABASE_SERVICE_ROLE_KEY=        # server-side only — never expose to the browser

# Junction Labs (see CARRIAGE_HEALTH_BUILD_SPEC.md §5)
# Default points at the sandbox. Only change to production after Junction grants access
# AND all BAAs are signed.
JUNCTION_API_KEY=                  # server-side only
JUNCTION_BASE_URL=https://api.sandbox.us.junction.com
JUNCTION_WEBHOOK_SECRET=           # server-side only — used to verify webhook signatures
# Phase 4: the Junction lab_test_id for the RPL panel.
# PLACEHOLDER: fd559cca-ba53-4742-982c-d670ba0183e1 ("Female Hormone Panel" sandbox default).
# Replace with your real panel's lab_test_id once created and approved in the Junction dashboard.
JUNCTION_LAB_TEST_ID=fd559cca-ba53-4742-982c-d670ba0183e1

# Stripe
STRIPE_SECRET_KEY=                 # server-side only (sk_test_... for sandbox)
STRIPE_WEBHOOK_SECRET=             # server-side only (whsec_...)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY= # safe to expose to the browser (pk_test_...)

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
